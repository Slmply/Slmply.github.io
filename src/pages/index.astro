---
import BaseLayout from '../layouts/base-layout.astro';
import ProjectCarousel from '../components/project-carousel.astro';

const allPosts = Object.values(import.meta.glob('./projects/*.md', { eager: true }));

const latest = allPosts.sort((a: any, b: any) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()).slice(0, 5);
---
<BaseLayout pageTitle="Home">
    <div class="flex flex-col w-full h-full">
        <div class="bg-moonstone p-8 h-84 justify-center align-baseline flex flex-col gap-4 w-full border-b-2">
            <h1 class="text-4xl font-bold">Welcome!</h1>
            <h2 class="text-2xl">My name is <b>Casey Groff</b>. This is what I've been working on.</h2>
            <a href="/about/" class="mr-auto p-2 px shadow-md transition-all hover:text-white hover:bg-richBlack hover:px-4 hover:underline">Learn More</a>
        </div>
    <div>
        <div class="-mt-12 p-4 mr-auto shadow-md border-2 border-richBlack border-l-0 flex h-18 w-84 bg-richBlack text-white align-center items-center justify-baseline">
            <h2 class="text-2xl">Latest Projects</h2>
        </div>
        <ProjectCarousel projects={latest}/>
    </div>
    </div>
</BaseLayout>