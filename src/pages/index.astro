---
import Navigation from '../components/navigation.astro';
import BaseLayout from '../layouts/base-layout.astro';

const allPosts = Object.values(import.meta.glob('./projects/*.md', { eager: true }));
---
<BaseLayout pageTitle="Home">
    <div class="flex flex-col w-full h-full gap-8">
        <div class="bg-moonstone p-8 mb-8 h-1/2 justify-center align-baseline flex flex-col gap-4 w-full [clip-path:polygon(0%_0%,100%_0%,100%_80%,0%_100%)]">
            <h1 class="text-2xl font-bold">Welcome to my Portfolio (Kinda)!</h1>
            <a href="/about/">Learn More</a>
        </div>
    <div>
        <h2>Projects</h2>
        <ul>
            {allPosts.map((post: any) => (
                <li><a href={post.url}>{post.frontmatter.title}</a></li>
            ))}
        </ul>
    </div>
    </div>
</BaseLayout>