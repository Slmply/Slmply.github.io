---
const { post } = Astro.props;
---
<li class="bg-cadetGray m-4 shadow-lg w-64 max-h-48 hover:max-h-120 border-2 border-black overflow-hidden transition-all">
    <a href={ post.url } class="group">
        <div class="bg-richBlack p-4 text-white flex justify-center align-center font-bold h-14 text-nowrap">
            <h2>{post.frontmatter.title}</h2>
        </div>
        <!-- wrap image + date -->
        <div class="relative">
            <img src={post.frontmatter.image.url} alt={post.frontmatter.image.alt} class="w-full h-34 flex object-cover"/>
            <time datetime={post.frontmatter.pubDate} class="absolute bottom-2 right-2 m-0 px-2 py-1 bg-richBlack text-white text-sm rounded" aria-label={`Published ${post.frontmatter.pubDate}`}>
                {post.frontmatter.pubDate.toString().slice(0,10)}
            </time>
        </div>
        <!-- ...existing code... -->
        <div class="p-4 italic max-h-14 overflow-hidden transition-all duration-300 group-hover:max-h-64 group-hover:overflow-auto">
            <p>{post.frontmatter.description}</p>
        </div>
    </a>
</li>