---
import "../styles/navigation.css";
const { pageTitle } = Astro.props;
---
<div class="flex w-screen bg-richBlack text-white m-0 p-0 border-b-2 border-richBlack shadow-sm shadow-black fixed top-0 z-10 h-16">
    <div class="flex text-center align-middle justify-center items-center text-xl font-bold pl-8 height-fit mt-0 mb-0 overflow-hidden">
        <h1 class="m-auto whitespace-nowrap">{pageTitle}</h1>
    </div>
    <div class="flex m-auto mr-8 items-center h-fill">
        <a href="/" class="menuItem">Home</a>
        <a href="/about/" class="menuItem">About</a>
        <a href="/projects" class="menuItem">Projects</a>
    </div>
</div>